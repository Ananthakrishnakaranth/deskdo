<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the DeskDo icon to reach the widget setup screen again. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_refresh"
        android:shortcutId="widget_setup"
        android:shortcutShortLabel="@string/setup_shortcut">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="app.deskdo.android.SetupActivity"
            android:targetPackage="app.deskdo.android" />
    </shortcut>
</shortcuts>
