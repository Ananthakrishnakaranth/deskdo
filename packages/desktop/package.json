{
  "name": "@deskdo/desktop",
  "productName": "DeskDo",
  "version": "1.0.0",
  "private": true,
  "description": "DeskDo desktop to-do widget",
  "author": "DeskDo",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.json && pnpm build:renderer && pnpm build:main",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "koffi": "3.3.7"
  },
  "devDependencies": {
    "@deskdo/shared": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "app.deskdo.widget",
    "productName": "DeskDo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@napi-rs/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskDo",
      "artifactName": "DeskDo-Setup-${version}.exe"
    }
  }
}
