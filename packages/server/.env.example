# Copy to packages/server/.env for local development. NEVER commit the real .env.

# Postgres connection string. Neon: Dashboard -> Connection Details -> "Pooled connection" off, copy URI.
DATABASE_URL=postgres://deskdo:deskdo@localhost:5432/deskdo
# Set to "true" for hosted Postgres that requires TLS (Neon, Render, Supabase). "false" for local.
DATABASE_SSL=false

# The single account allowed to sign in.
ACCOUNT_EMAIL=you@example.com
# bcrypt hash of your password. Generate with:  pnpm --filter @deskdo/server hash-password
# Wrap it in single quotes; bcrypt hashes contain "$".
ACCOUNT_PASSWORD_HASH='$2b$12$replace.this.with.the.output.of.hash-password..........'

# Random secret (>= 32 chars) for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs out every device.
JWT_SECRET=replace-with-at-least-32-random-characters

# Session lifetime in days (desktop token / PWA cookie).
TOKEN_TTL_DAYS=90

PORT=8080
# Directory with the built PWA, served at "/". Leave empty to run API-only.
STATIC_DIR=../mobile/dist
# Extra origins allowed to open cookie-authenticated WebSockets (comma-separated). Same-origin is always allowed.
ALLOWED_ORIGINS=
# Force the Secure flag on the session cookie. Auto-detected behind HTTPS proxies (Render) when unset.
COOKIE_SECURE=
